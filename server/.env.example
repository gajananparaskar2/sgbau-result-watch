# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
DATABASE_PATH=./data/resultwatch.sqlite

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# ── Monitoring ───────────────────────────────────────────────
RESULT_MONITOR_INTERVAL_MINUTES=60
RESULT_REQUEST_TIMEOUT_MS=20000
RESULT_MAX_RETRIES=3

# ── SGBAU adapter ────────────────────────────────────────────
# Official result search page. Discovered by inspecting the live SGBAU
# "Smart Examination System" portal. See README > SGBAU adapter.
SGBAU_RESULT_URL=https://sgbau.ucanapply.com/result-details
SGBAU_RESULT_SEARCH_ENDPOINT=https://sgbau.ucanapply.com/result-details

# ── Email (optional) ─────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ResultWatch <no-reply@example.com>

# ── Mock / development ───────────────────────────────────────
# When true, the monitoring worker uses the mock adapter instead of
# contacting SGBAU. Never set this to true in production.
MOCK_RESULT_MODE=false

# ── Uploads (fallback path) ──────────────────────────────────
UPLOAD_DIR=./uploads
PDF_OUTPUT_DIR=./generated-pdfs

# ── Admin seed (used only by seed script) ───────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
